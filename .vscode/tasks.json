{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: Dev",
      "type": "shell",
      "command": "npm install && npm start",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Frontend: Dev",
      "type": "shell",
      "command": "npm install && npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/Frontend"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "🚀 Full Dev Start",
      "dependsOn": [
        "Backend: Dev",
        "Frontend: Dev"
      ],
      "dependsOrder": "parallel"
    }
  ]
}
